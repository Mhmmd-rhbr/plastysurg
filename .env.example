# ========================================
# FaceVision Medical — Environment Variables
# ========================================

# --- AI API Keys ---
GEMINI_API_KEY=your_gemini_api_key_here
MESHY_API_KEY=your_meshy_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Application Mode ---
# Set to 'true' to use mock data for all AI API calls (no API keys needed)
DEMO_MODE=true

# --- Authentication ---
JWT_SECRET=change_this_to_a_random_64_character_string_for_production_use_only

# --- Server ---
PORT=3001
CLIENT_PORT=5173
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- File Storage ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# --- Database ---
DB_PATH=./data/facevision.db
